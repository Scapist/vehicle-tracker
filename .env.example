# Copy to .env and adjust. Every setting is explained in docs/DEPLOY.md.

# Your timezone (tz database name, e.g. America/Toronto, Europe/Paris). Decides "today" and when the daily
# alerts (08:00) and odometer nudges (18:00) go out.
TIMEZONE=America/Toronto

# Which address port 8000 listens on. 127.0.0.1 = only this machine; your LAN IP = your home network.
BIND_ADDR=127.0.0.1
# Every host name/IP you open the app by (blocks DNS rebinding); add your server's LAN IP or hostname.
ALLOWED_HOSTS=localhost,127.0.0.1
# Behind a reverse proxy or `tailscale serve`: the address it connects from, so sign-in limits see real devices.
# Same machine: Docker's gateway (often 172.17.0.1 or 172.18.0.1). Another machine/container: its IP.
# FORWARDED_ALLOW_IPS=172.17.0.1

# log = alerts only go to the container log (testing). telegram, discord or chat = send them through the bots below.
NOTIFIER=log
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# Optional: only these Discord user ids may talk to the bot at all (comma-separated).
# DISCORD_ALLOWED_USER_IDS=

# MCP server for AI assistants at /mcp (Claude Desktop / Claude Code). Off by default.
MCP_ENABLED=false
# owner = only the owner account may create access tokens; all = every account (each sees only their own data).
MCP_USERS=owner
