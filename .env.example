BIND_ADDR=127.0.0.1
# host names/IPs you open the app by (blocks DNS rebinding); add your server LAN IP or hostname
ALLOWED_HOSTS=localhost,127.0.0.1
# behind a reverse proxy on another host/container: its IP, so sign-in limits see real devices
# FORWARDED_ALLOW_IPS=172.17.0.1
NOTIFIER=log
TELEGRAM_BOT_TOKEN=
