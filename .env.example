BIND_ADDR=127.0.0.1
# host names/IPs you open the app by (blocks DNS rebinding); add your server LAN IP or hostname
ALLOWED_HOSTS=localhost,127.0.0.1
# behind a reverse proxy on another host/container: its IP, so sign-in limits see real devices
# FORWARDED_ALLOW_IPS=172.17.0.1
# log = alerts only go to the container log (testing); telegram (or chat) = send them through the chat apps below
NOTIFIER=log
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# optional: only these Discord user ids may talk to the bot at all (comma-separated)
# DISCORD_ALLOWED_USER_IDS=
# MCP server for AI assistants at /mcp (Claude Desktop / Claude Code). Off by default.
MCP_ENABLED=false
# owner = only the owner account may create access tokens; all = every account (each sees only their own data)
MCP_USERS=owner
